<h1>Contas</h1>

<table>
  <thead>
    <tr>
      <th>ID</th>
      <th>Nome do Titular</th>
      <th>Saldo</th>
      <th>Ações</th>
    </tr>
  </thead>
  <tbody>
    <% @accounts.each do |account| %>
      <tr>
        <td><%= account.id %></td>
        <td><%= account.user.name %></td>
        <td><%= number_to_currency(account.balance) %></td>
        <td>
          <%= link_to 'Ver Detalhes', account_path(account) %>
        </td>
      </tr>
    <% end %>
  </tbody>
</table>

<%= link_to 'Nova Transferência', new_transfer_path %>