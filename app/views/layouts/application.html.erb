<!DOCTYPE html>
<html>
<head>
  <title>Demo Banco</title>
  <%= csrf_meta_tags %>
  <%= csp_meta_tag %>

  <%= stylesheet_link_tag 'application', media: 'all' %>
  <%= javascript_pack_tag 'application' %>
</head>
<body>
  <header>
    <h1>Bem-vindo ao Demo Banco</h1>
    <nav>
      <ul>
        <li><%= link_to 'Dashboard', dashboard_path %></li>
        <li><%= link_to 'Contas', accounts_path %></li>
        <li><%= link_to 'Transferências', new_transfer_path %></li>
        <li><%= link_to 'Sair', destroy_user_session_path, method: :delete %></li>
      </ul>
    </nav>
  </header>

  <main>
    <%= yield %>
  </main>

  <footer>
    <p>&copy; <%= Time.current.year %> Demo Banco</p>
  </footer>
</body>
</html>